# --- Required ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_db
REDIS_PASSWORD=change_me_redis
# Min 32 chars. Generate: openssl rand -base64 48
JWT_KEY=change_me_at_least_32_characters_long
# Auto-created as SuperAdmin on first login with this email
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin

# --- Optional ---
MYSQL_DATABASE=TodoApp_BToM
MYSQL_USER=todoapp
APP_PORT=8080
# Image source/version (docker-compose.release.yml)
GHCR_OWNER=jin3107
TODOAPP_TAG=latest

# Email for scheduled reports (leave empty to skip)
SMTP_USERNAME=
SMTP_PASSWORD=
RECIPIENT_EMAIL=
