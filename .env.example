# Email Settings (for scheduled reports)
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
RECIPIENT_EMAIL=recipient@example.com

# MySQL Database
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=TodoApp_BToM
MYSQL_USER=dev
MYSQL_PASSWORD=your_mysql_password

# Redis Password (CHANGE THIS!)
REDIS_PASSWORD=your_secure_redis_password_here

# Bootstrap SuperAdmin (auto-created on first login with this email)
BOOTSTRAP_ADMIN_EMAIL=your_admin_email@example.com
BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password_here
